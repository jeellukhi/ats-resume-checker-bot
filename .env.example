# ============================================================
# ATS Resume Checker Bot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ============================================================

# ── Telegram ─────────────────────────────────────────────────
# Get this from @BotFather on Telegram (see README for steps)
TELEGRAM_BOT_TOKEN=

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: "gemini" (recommended, free tier available), "openai", or "anthropic"
LLM_PROVIDER=gemini

# ── API Keys ─────────────────────────────────────────────────────────────────
# Google Gemini — get a FREE key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ── Model Selection (optional) ────────────────────────────────────────────────
# Override the default model if desired
# GEMINI_MODEL=gemini-2.0-flash         # default
# OPENAI_MODEL=gpt-4o-mini              # default
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022  # default

# ── Database ─────────────────────────────────────────────────
# Path to the SQLite database file (created automatically)
# DB_PATH=data/ats_bot.db

# ── Logging ──────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
# Log to a file (leave empty to log to console only)
# LOG_FILE=bot.log
